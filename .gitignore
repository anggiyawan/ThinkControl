# ==========================================
# ThinkControl - Git Ignore Rules
# ==========================================

# 1. Byte-compiled / optimized Python files
__pycache__/
*.py[cod]
*$py.class

# 2. Package build outputs & temporary directories
# (Binary .deb packages should be published via GitHub Releases, not stored in git repo)
*.deb
build_deb/
dist/
build/
*.egg-info/

# 3. Temporary / unorganized screenshots in root
# (Official documentation images are organized under assets/)
screenshoot.png
Screenshot.png
*.orig

# 4. Virtual environments
.venv/
venv/
ENV/
env/

# 5. IDE & Editor specific files
.vscode/
.idea/
*.swp
*.swo
*~

# 6. System & log files
*.log
.DS_Store
Thumbs.db
